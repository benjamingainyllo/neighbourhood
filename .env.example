# Copy this file to ".env.local" (on your computer) or add these in
# Vercel -> your project -> Settings -> Environment Variables.

# Your live website address (no slash at the end). Vercel fills this in
# automatically, but set it once you connect your own domain.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Newsletter: choose one of beehiiv, convertkit or mailchimp.
# Leave empty to keep the form in placeholder mode.
NEWSLETTER_PROVIDER=

# Beehiiv (Settings -> Integrations -> API)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ConvertKit / Kit (Settings -> Developer)
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Mailchimp (Account -> Extras -> API keys; Audience -> Settings for the ID)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
